              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">Modell ans Backend schicken, rechnen lassen, Ergebnisse zurueckholen. Laeuft in einem eigenen Prozess (Backends brauchen Python &gt;= 3.10). NUR per Button ausloesen — jeder Lauf baut das RFEM-Modell neu auf und blockiert Grasshopper, solange gerechnet wird.</item>
                    <item name="GraftStandardOutputLines" type_name="gh_bool" type_code="1">true</item>
