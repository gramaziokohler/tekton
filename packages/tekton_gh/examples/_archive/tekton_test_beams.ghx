              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">Bundles the backend and its connection data. The API key does NOT belong in the GH file - that file gets emailed around. Leave it empty (the worker reads TEKTON_API_KEY / DLUBAL_API_KEY or the repo's .env) or pass the path to a file holding the key.</item>
                    <item name="GraftStandardOutputLines" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconOverride" type_name="gh_drawing_bitmap" type_code="37">
                      <bitmap length="312"></bitmap>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">f5c9741a-c9ba-49ea-a398-63c8b3480233</item>
                    <item name="MarshGuids" type_name="gh_bool" type_code="1">true</item>
                    <item name="MarshInputs" type_name="gh_bool" type_code="1">true</item>
                    <item name="MarshOutputs" type_name="gh_bool" type_code="1">true</item>
                    <item name="Name" type_name="gh_string" type_code="10">Tekton Backend</item>
                    <item name="NickName" type_name="gh_string" type_code="10">TBackend</item>
                    <item name="ScriptComponentVersion" type_name="gh_int32" type_code="3">3</item>
                    <item name="Tooltip" type_name="gh_string" type_code="10"></item>
