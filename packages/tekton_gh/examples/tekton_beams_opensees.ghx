              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">The core of the bridge: TimberModel -&gt; neutral StructuralModel. Produces system lines, nodes, cross-sections, releases, supports. The 'report' output lists every assumption made - that is not debug output, it is what the engineer will argue about later.</item>
                    <item name="GraftStandardOutputLines" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconOverride" type_name="gh_drawing_bitmap" type_code="37">
                      <bitmap length="406"></bitmap>
                    </item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">c74a3030-2aa3-4415-8f3b-6f5e3a5374a2</item>
                    <item name="MarshGuids" type_name="gh_bool" type_code="1">true</item>
                    <item name="MarshInputs" type_name="gh_bool" type_code="1">true</item>
