                <item name="Name" type_name="gh_string" type_code="10">Tekton Upgrade</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">Brings every Tekton component in this definition up to date with one button press. A component you placed keeps the script it was placed with, even when Tekton is updated; this swaps each one for the current version, in place, with its wires and nickname. Press it after a Tekton update. The report tells you what was replaced and names any wire it could not carry over (a renamed or removed input) - reconnect those by hand. Nothing else on the canvas is touched.</item>
                    <item name="GraftStandardOutputLines" type_name="gh_bool" type_code="1">true</item>
                    <item name="IconOverride" type_name="gh_drawing_bitmap" type_code="37">
                      <bitmap length="530"></bitmap>
