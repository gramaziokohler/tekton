              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">Send the model to the backend, calculate, fetch the results back. Runs in a separate process (backends need Python &gt;= 3.10). Trigger by button ONLY - every run rebuilds the RFEM model from scratch and blocks Grasshopper while it calculates.</item>
                    <item name="GraftStandardOutputLines" type_name="gh_bool" type_code="1">true</item>
