              <chunks count="1">
                <chunk name="Container">
                  <items count="15">
                    <item name="Description" type_name="gh_string" type_code="10">Mark support points on beams. Writes beam.attributes['support_points'] - the only channel the translator reads today. The points have to lie on the beam axis (tolerance 1e-4 in model units).</item>
